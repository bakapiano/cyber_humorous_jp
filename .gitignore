# Local runtime data, scratch work and private credentials.
.env
.env.*
!.env.example
.secrets/
/.tmp/
private/
data/
artifacts/
logs/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
node_modules/
dist/
coverage/
playwright-report/
test-results/
.ruff_cache/
*.tsbuildinfo

# Public source repository: explicit root allowlist.
/*
!/.gitignore
!/.gitattributes
!/.gitleaks.toml
!/.env.example
!/README.md
!/SECURITY.md
!/.prettierrc.json
!/eslint.config.mjs
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/playwright.config.ts
!/start.ps1
!/stop.ps1
!/backend/
!/frontend/
!/services/
!/extensions/
!/packages/
!/contracts/
!/config/
!/e2e/
!/tooling/
!/docs/
/docs/*
!/docs/architecture.md
!/docs/SETUP.md

# Never publish credentials, local history, runtime state or downloaded media.
**/.secrets/
**/.tmp/
**/.git/
**/.env
**/.env.*
!/.env.example
**/AGENTS.md
**/.import_linter_cache/
**/ds_key
**/youtube_key
**/youtube_json.txt
**/*cookies*.txt
**/*cookie*.json
**/*session*.json
**/*credentials*.json
**/*token*.txt
**/*api_key*.txt
**/*session*.dpapi
**/*.har
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db
**/*.log
**/*.mp4
**/*.webm
**/*.mkv
**/*.wav
**/*.mp3
**/*.m4a
**/*.zip
**/*.7z
**/*.exe
**/*.dll
