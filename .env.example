# Documentation template only. The application does not automatically load this file.
# Set environment variables in the process that launches the services.
# Never place real secrets in a tracked file.

YOUTUBE_API_KEY=replace_with_your_own_youtube_data_api_key
DEEPSEEK_API_KEY=replace_with_your_own_deepseek_api_key

# Point this to your own ignored WorkBuddy gateway config if using that route.
# WORKFLOW_WORKBUDDY_CONFIG=C:/your-private-config/workbuddy.json
# WORKFLOW_PROXY=http://127.0.0.1:7897
# WORKFLOW_ASR_DEVICE=cuda
# WORKFLOW_SUBTITLE_FONT=C:/Windows/Fonts/msyh.ttc

# No live publication is enabled by this example.
WORKFLOW_LIVE_PUBLICATION=0
